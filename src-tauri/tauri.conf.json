{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIO Launcher",
  "version": "1.0.0",
  "identifier": "com.void0.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIO Launcher",
        "width": 1280,
        "height": 780,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "AIO Overlay",
        "url": "index.html?overlay=1",
        "width": 340,
        "height": 340,
        "x": 24,
        "y": 24,
        "center": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
